<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.funding</groupId>
    <artifactId>funding-automation</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>funding-domain</artifactId>

  <dependencies>
    <!-- JSON parsing for the external API response classifier (pure function, no framework). -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-frameworks</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*</exclude>
                    <exclude>io.temporal</exclude>
                  </excludes>
                  <includes><include>*:*:*:*:test</include></includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- META-INF/rule-fingerprints.properties: SHA-256 of each RuleCatalog evaluator source (P-2.5). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>rule-fingerprints</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.funding.domain.build.RuleFingerprintWriter</mainClass>
              <arguments>
                <argument>${project.basedir}/src/main/java</argument>
                <argument>${project.build.outputDirectory}/META-INF/rule-fingerprints.properties</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
